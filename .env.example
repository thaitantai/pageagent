# Fanpage Agent local configuration
# Copy this file to .env and fill in real values locally.
# Do not commit .env or real credentials.

# LLM provider
LLM_PROVIDER=mock-local
LLM_MODEL=mock-local
LLM_MODEL_CANDIDATES=
LLM_MAX_TOKENS=1200

# Example OpenAI-compatible provider setup
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=<your-api-key>
# LLM_MODEL=google/gemma-3-27b-it:free
# LLM_MODEL_CANDIDATES=meta-llama/llama-3.3-8b-instruct:free,mistralai/mistral-small-3.2-24b-instruct:free
# LLM_MAX_TOKENS=1200

# Store backend: local or google
STORE_BACKEND=local

# Google Sheets backend, required only when STORE_BACKEND=google
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
GOOGLE_SHEETS_TABS_PREFIX=fanpage_agent

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BASE_URL=https://api.telegram.org

# Optional artifact directory override
# ARTIFACTS_DIR=/absolute/path/to/artifacts
